{
  "name": "@understand-arch/plugin",
  "version": "3.7.0-rc2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "arch:test": "vitest run --config engine/arch/vitest.config.mjs",
    "diagram:test": "bash vendor/fireworks-tech-graph/scripts/test-all-styles.sh",
    "dispatch:lint": "node engine/arch/dispatch-lint.mjs --strict",
    "plugin:doctor": "node scripts/doctor-plugin-install.mjs --strict",
    "plugin:install": "node scripts/install-claude-plugin.mjs",
    "test": "pnpm arch:test && pnpm --filter @understand-arch/core test && pnpm --filter @understand-arch/core build && pnpm --filter @understand-arch/dashboard test",
    "verify": "pnpm dispatch:lint && pnpm test && pnpm --filter @understand-arch/core build && pnpm --filter @understand-arch/dashboard build"
  },
  "dependencies": {
    "@understand-arch/core": "workspace:*",
    "graphology": "~0.26.0",
    "graphology-communities-louvain": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
