{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/repository-component-inventory.schema.json",
  "title": "仓库与组件清单",
  "description": "arch-analyze --depth=manifest 产出的仓库、组件、入口、构建与部署清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "generated_at",
    "generated_by",
    "depth",
    "baseline_commits",
    "repositories",
    "components",
    "analysis_failures",
    "evidence_refs"
  ],
  "properties": {
    "project_name": { "$ref": "#/$defs/kebabName" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generated_by": { "type": "string", "const": "arch-analyze" },
    "depth": { "type": "string", "enum": ["manifest", "model", "risk", "full"] },
    "baseline_commits": { "$ref": "#/$defs/baselineCommits" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "analysis_failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisFailure" }
    },
    "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
  },
  "$defs": {
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "baselineCommits": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{7,64}|git_unavailable)$"
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "commit"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "line": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^\\d+(?:-\\d+)?$" },
            { "type": "string", "const": "not_applicable" }
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{7,64}|git_unavailable|external)$"
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "pathList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "repo_type",
        "primary_languages",
        "owner",
        "entrypoints",
        "build",
        "deploy",
        "test",
        "source",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabName" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "repo_type": {
          "type": "string",
          "enum": ["service", "library", "frontend", "worker", "infra-docs", "monorepo", "unknown"]
        },
        "primary_languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "entrypoints": { "$ref": "#/$defs/pathList" },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "commands", "evidence_refs"],
          "properties": {
            "system": { "$ref": "#/$defs/nonEmptyString" },
            "commands": { "$ref": "#/$defs/pathList" },
            "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
          }
        },
        "deploy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "strategy", "config_paths", "evidence_refs"],
          "properties": {
            "unit": { "$ref": "#/$defs/nonEmptyString" },
            "strategy": { "$ref": "#/$defs/nonEmptyString" },
            "config_paths": { "$ref": "#/$defs/pathList" },
            "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frameworks", "commands", "evidence_refs"],
          "properties": {
            "frameworks": { "$ref": "#/$defs/pathList" },
            "commands": { "$ref": "#/$defs/pathList" },
            "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
          }
        },
        "source": {
          "type": "string",
          "enum": ["deterministic_scan", "external_kb", "manual", "mixed"]
        },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repo_id",
        "type",
        "path",
        "responsibility",
        "owner",
        "runtime",
        "interfaces",
        "evidence_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabName" },
        "repo_id": { "$ref": "#/$defs/kebabName" },
        "type": {
          "type": "string",
          "enum": ["service", "module", "package", "database", "queue", "job", "ui", "cli", "unknown"]
        },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "responsibility": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "runtime": { "$ref": "#/$defs/nonEmptyString" },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "kind": {
                "type": "string",
                "enum": ["http", "rpc", "event", "database", "file", "cli", "unknown"]
              },
              "description": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "analysisFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "phase", "reason"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nonEmptyString" },
        "phase": { "type": "string", "enum": ["manifest", "model", "risk", "full"] },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
