{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/specs-risks.schema.json",
  "title": "Specs Risks",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks", "tech_debts", "last_reviewed", "evidence_refs"],
  "properties": {
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "tech_debts": {
      "type": "array",
      "items": { "$ref": "#/$defs/debt" }
    },
    "last_reviewed": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "category",
        "affected_scope",
        "description",
        "mitigation",
        "owner",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "category": { "type": "string", "minLength": 1 },
        "affected_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "last_reviewed": {
          "type": "string",
          "description": "可选;通常由 audit/drift 跑时机器写入,不要求人工维护"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "debt_type",
        "affected_scope",
        "impact",
        "paydown_strategy",
        "owner",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "debt_type": { "type": "string", "minLength": 1 },
        "affected_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cost_of_delay": { "type": "string" },
        "impact": { "type": "string", "minLength": 1 },
        "paydown_strategy": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    }
  }
}
