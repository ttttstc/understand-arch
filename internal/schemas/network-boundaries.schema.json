{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/kb-network-boundaries.schema.json",
  "title": "network-boundaries",
  "description": "企业知识库：网络分区、访问方向与例外审批约束。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "updated_at", "boundaries"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "owner": { "$ref": "#/$defs/nonEmptyString" },
    "updated_at": { "type": "string", "format": "date" },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/boundary" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "source_zone",
        "target_zone",
        "direction",
        "allowed_protocols",
        "approval_required",
        "detection_hints"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^NB-[A-Z0-9-]+$" },
        "rule": { "$ref": "#/$defs/nonEmptyString" },
        "source_zone": { "$ref": "#/$defs/nonEmptyString" },
        "target_zone": { "$ref": "#/$defs/nonEmptyString" },
        "direction": { "type": "string", "enum": ["inbound", "outbound", "bidirectional", "none"] },
        "allowed_protocols": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "approval_required": { "$ref": "#/$defs/nonEmptyString" },
        "detection_hints": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
