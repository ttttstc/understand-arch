{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/kb-naming-conventions.schema.json",
  "title": "naming-conventions",
  "description": "企业知识库：命名规范，用于设计与评审阶段的一致性检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "updated_at", "conventions"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "owner": { "$ref": "#/$defs/nonEmptyString" },
    "updated_at": { "type": "string", "format": "date" },
    "conventions": {
      "type": "array",
      "items": { "$ref": "#/$defs/convention" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "applies_to",
        "rule",
        "pattern",
        "examples",
        "anti_examples",
        "severity"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^NC-[A-Z0-9-]+$" },
        "applies_to": { "$ref": "#/$defs/nonEmptyString" },
        "rule": { "$ref": "#/$defs/nonEmptyString" },
        "pattern": { "$ref": "#/$defs/nonEmptyString" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "anti_examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    }
  }
}
