{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/v2/repos.schema.json",
  "title": "understand-arch v2 repos registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repos"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "git_remote", "primary_language"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "git_remote": { "type": "string" },
          "primary_language": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}

