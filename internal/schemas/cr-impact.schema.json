{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/cr-impact.schema.json",
  "title": "Change Request Impact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cr_id",
    "summary",
    "scope_boundary",
    "impacts",
    "derived_risks",
    "writeback_targets",
    "evidence_refs"
  ],
  "properties": {
    "cr_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_change", "may_change", "should_not_change"],
      "properties": {
        "must_change": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "may_change": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "should_not_change": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "services",
        "modules",
        "apis",
        "data_models",
        "events_messages",
        "permissions",
        "deployments",
        "configs"
      ],
      "properties": {
        "services": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "apis": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "data_models": { "type": "array", "items": { "$ref": "#/$defs/dataImpactItem" } },
        "events_messages": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "deployments": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } },
        "configs": { "type": "array", "items": { "$ref": "#/$defs/impactItem" } }
      }
    },
    "derived_risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/derivedRisk" }
    },
    "writeback_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/writebackTarget" }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "impactItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "change_type", "summary", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "change_type": { "type": "string", "enum": ["add", "modify", "deprecate", "remove", "no_impact"] },
        "summary": { "type": "string", "minLength": 1 },
        "dependency_change": { "type": "string" },
        "rollback_strategy": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "dataImpactItem": {
      "allOf": [
        { "$ref": "#/$defs/impactItem" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["migration", "backfill", "compatibility", "rollback_strategy"],
          "properties": {
            "migration": { "type": "string", "minLength": 1 },
            "backfill": { "type": "string", "minLength": 1 },
            "compatibility": { "type": "string", "minLength": 1 },
            "rollback_strategy": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "derivedRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description", "mitigation", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "description": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string", "minLength": 1 },
        "related_existing_risk": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "writebackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_spec", "expected_action"],
      "properties": {
        "target_spec": { "type": "string", "minLength": 1 },
        "expected_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
