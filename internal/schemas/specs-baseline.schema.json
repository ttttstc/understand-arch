{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/specs-baseline.schema.json",
  "title": "Specs Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "repositories",
    "components",
    "interfaces",
    "data_models",
    "external_dependencies",
    "deployment_units",
    "runtime_configs",
    "critical_flows",
    "ownership",
    "capabilities",
    "view_coverage",
    "known_unknowns",
    "last_verified",
    "last_scanned_commit",
    "changed_files_since_scan",
    "freshness_status",
    "baseline_commits",
    "evidence_refs"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "owners"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apis", "events", "messages"],
      "properties": {
        "apis": { "type": "array", "items": { "$ref": "#/$defs/interfaceItem" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/interfaceItem" } },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/interfaceItem" } }
      }
    },
    "data_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataModel" }
    },
    "external_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalDependency" }
    },
    "deployment_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedFact" }
    },
    "runtime_configs": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedFact" }
    },
    "critical_flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/criticalFlow" }
    },
    "ownership": {
      "type": "array",
      "items": { "$ref": "#/$defs/ownership" }
    },
    "capabilities": {
      "type": "array",
      "description": "业务能力地图(原 specs/capabilities.yaml,v1.0 收敛进 baseline)。把'业务能力'层显式建模:同一能力可由多个组件承载,同一组件可服务多个能力。空数组表示尚未抽取(常见于 onboard 首跑前)。",
      "items": { "$ref": "#/$defs/capability" }
    },
    "view_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "4+1 视图覆盖状态(v1.0 松绑:不强制 5 维子字段,只要 status + note)。",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "missing"],
          "description": "complete=4+1 全覆盖 / partial=部分覆盖(note 说明) / missing=未做"
        },
        "note": {
          "type": "string",
          "description": "可选;partial / missing 时建议填,说明缺哪几维"
        },
        "logical": { "$ref": "#/$defs/viewStatus" },
        "development": { "$ref": "#/$defs/viewStatus" },
        "process": { "$ref": "#/$defs/viewStatus" },
        "physical": { "$ref": "#/$defs/viewStatus" },
        "scenarios": { "$ref": "#/$defs/viewStatus" }
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/knownUnknown" }
    },
    "last_verified": { "type": "string", "minLength": 1 },
    "last_scanned_commit": { "type": "string", "minLength": 1 },
    "changed_files_since_scan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "freshness_status": {
      "type": "string",
      "enum": ["fresh", "possibly_stale", "stale", "unknown"]
    },
    "baseline_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "commit"],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "viewStatus": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "importance",
        "maturity",
        "supporting_components",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAP-[0-9]{3}$",
          "description": "能力 id,CAP-001 三位连续编号。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "业务能力名(中文优先,例 '订阅计费' / '内容推荐')。"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "一句话说明该能力对业务的意义(≤30 字)。"
        },
        "category": {
          "type": "string",
          "description": "可选业务域分组(例 '账务' / '用户' / '推送' / '内容')。"
        },
        "importance": {
          "type": "string",
          "enum": ["core", "supporting", "peripheral"]
        },
        "maturity": {
          "type": "string",
          "enum": ["mature", "evolving", "experimental", "deprecated", "missing"]
        },
        "supporting_components": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "role"],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1,
                "description": "组件名,必须存在于本文件 components[]"
              },
              "role": {
                "type": "string",
                "enum": ["primary", "secondary", "shared"]
              }
            }
          }
        },
        "user_facing": {
          "type": "boolean",
          "description": "是否直接面向最终用户"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": { "type": "string", "minLength": 1 },
              "related_risks": {
                "type": "array",
                "items": { "type": "string", "pattern": "^R-[0-9]{3}$" }
              },
              "related_open_questions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "namedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "owner", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "repository": {
      "allOf": [
        { "$ref": "#/$defs/namedFact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "language", "responsibility"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "language": { "type": "string", "minLength": 1 },
            "responsibility": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "component": {
      "allOf": [
        { "$ref": "#/$defs/namedFact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["component_type", "repository_id"],
          "properties": {
            "component_type": { "type": "string", "minLength": 1 },
            "repository_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "interfaceItem": {
      "allOf": [
        { "$ref": "#/$defs/namedFact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exposed_by", "compatibility"],
          "properties": {
            "exposed_by": { "type": "string", "minLength": 1 },
            "compatibility": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "dataModel": {
      "allOf": [
        { "$ref": "#/$defs/namedFact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_write_boundary",
            "compatibility_constraints",
            "migration_notes",
            "rollback_notes"
          ],
          "properties": {
            "read_write_boundary": { "type": "string", "minLength": 1 },
            "compatibility_constraints": { "type": "string", "minLength": 1 },
            "migration_notes": { "type": "string", "minLength": 1 },
            "rollback_notes": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "externalDependency": {
      "allOf": [
        { "$ref": "#/$defs/namedFact" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sla_or_risk", "fallback_path"],
          "properties": {
            "sla_or_risk": { "type": "string", "minLength": 1 },
            "fallback_path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "criticalFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "steps", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "owner", "status", "evidence_refs"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["confirmed", "unknown_owner"] },
        "reason": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "knownUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact", "next_action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
