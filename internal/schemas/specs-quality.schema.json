{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/specs-quality.schema.json",
  "title": "Specs Quality",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nfrs",
    "runtime_constraints",
    "release_constraints",
    "rollback_constraints",
    "org_constraints",
    "evidence_refs"
  ],
  "properties": {
    "nfrs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reliability",
        "latency",
        "performance",
        "cost",
        "security",
        "compliance",
        "observability",
        "maintainability"
      ],
      "properties": {
        "reliability": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "latency": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "performance": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "cost": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "security": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "compliance": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "observability": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } },
        "maintainability": { "type": "array", "items": { "$ref": "#/$defs/qualityEntry" } }
      }
    },
    "runtime_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraintEntry" }
    },
    "release_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraintEntry" }
    },
    "rollback_constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraintEntry" }
    },
    "org_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "banned_patterns",
        "compliance_redlines",
        "network_boundaries",
        "naming_conventions",
        "tech_radar"
      ],
      "properties": {
        "banned_patterns": { "$ref": "#/$defs/constraintBundle" },
        "compliance_redlines": { "$ref": "#/$defs/constraintBundle" },
        "network_boundaries": { "$ref": "#/$defs/constraintBundle" },
        "naming_conventions": { "$ref": "#/$defs/constraintBundle" },
        "tech_radar": { "$ref": "#/$defs/constraintBundle" }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "qualityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "current_state", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "current_state": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "constraintEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "severity": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "constraintBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["loaded", "not_loaded", "not_configured"]
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraintEntry" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
