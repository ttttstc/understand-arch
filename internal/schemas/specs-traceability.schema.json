{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/specs-traceability.schema.json",
  "title": "Specs Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "relations", "last_verified", "evidence_refs"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "last_verified": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "artifact_type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "status": { "type": "string" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_artifact", "to_artifact", "relation_type", "evidence_refs"],
      "properties": {
        "from_artifact": { "type": "string", "minLength": 1 },
        "to_artifact": { "type": "string", "minLength": 1 },
        "relation_type": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    }
  }
}
