{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/cr-traceability.schema.json",
  "title": "Change Request Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cr_id",
    "requirements",
    "design_elements",
    "tasks",
    "writeback_plan",
    "evidence_refs"
  ],
  "properties": {
    "cr_id": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceNode" }
    },
    "design_elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceNode" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceNode" }
    },
    "writeback_plan": {
      "type": "array",
      "items": { "$ref": "#/$defs/writebackEntry" }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRef" }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "commit"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "traceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "targets", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "writebackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_spec", "action", "source_ids"],
      "properties": {
        "target_spec": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["create", "update", "none"] },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
