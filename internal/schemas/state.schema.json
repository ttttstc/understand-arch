{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understand-arch.dev/schemas/v2/state.schema.json",
  "title": "understand-arch v2 workflow state",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "project", "status", "current_skill", "history", "overrides", "hooks_enabled"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "project": { "type": "string" },
    "status": { "type": "string", "enum": ["idle", "running", "completed", "blocked", "degraded"] },
    "current_skill": { "type": ["string", "null"] },
    "current_phase": { "type": ["string", "null"] },
    "hooks_enabled": { "type": "boolean", "default": false },
    "last_graph_refresh": { "type": ["string", "null"] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["ts", "skill", "action", "status"],
        "properties": {
          "ts": { "type": "string" },
          "skill": {
            "type": "string",
            "enum": [
              "arch-onboard",
              "arch-design",
              "arch-audit",
              "arch-wiki",
              "arch-diagram",
              "arch-analyze",
              "arch-frame",
              "arch-adr",
              "arch-review",
              "arch-project-scanner",
              "arch-file-analyzer",
              "arch-architecture-analyzer",
              "arch-domain-analyzer",
              "arch-quality-analyzer",
              "arch-graph-reviewer",
              "arch-impact-analyzer",
              "arch-solution-designer",
              "arch-senior-reviewer",
              "user"
            ]
          },
          "action": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "scope", "reason", "by"],
        "properties": {
          "ts": { "type": "string" },
          "scope": { "type": "string" },
          "reason": { "type": "string", "minLength": 20 },
          "by": { "type": "string" }
        }
      }
    }
  }
}
